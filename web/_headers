# Cloudflare Pages headers. Cross-origin isolation enables SharedArrayBuffer, which the
# threaded Godot web build needs.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-cache

# Every deploy reuses the same file names, so browsers must revalidate everything
# (unchanged files come back as a cheap 304). The retired service worker must never be
# cached, or browsers would keep the old one.
/index.service.worker.js
  Cache-Control: no-store
